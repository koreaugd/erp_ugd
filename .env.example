# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GAS_URL: Google Apps Script Web App deployed URL for real Google Sheets database sync.
VITE_GAS_URL="https://script.google.com/macros/s/YOUR_ID/exec"

# Firebase Config (Automatically configured but documented here)
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"

# KAKAO_T_CORP_ID_2 / KAKAO_T_SECRET_2: 카카오T 비즈니스(법인택시) 2계정 연동 정보.
# 계정 #1(KAKAO_T_CORP_ID / KAKAO_T_SECRET)은 기존 .env 값을 그대로 쓴다 — 값은 비워 둔다(실제 시크릿 금지).
KAKAO_T_CORP_ID_2=
KAKAO_T_SECRET_2=

