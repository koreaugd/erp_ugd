rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Firebase 내부 관리자 계정입니다. 실제 로그인 화면에는 노출하지 않습니다.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@ugd-erp.example';
    }

    // 개인 계정 관리자 판정 — users 문서 기반. status + 승인(reviewedByAdmin)까지 확인한다.
    // reviewedByAdmin을 빼면 미승인 상태의 role:admin 계정이 업무 데이터에 접근하는 구멍이 생긴다(Codex 지적 2026-07-27).
    // 첫 관리자는 Firebase 콘솔에서 role='admin' · status='active' · reviewedByAdmin=true 로 직접 설정한다.
    function isPersonalAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reviewedByAdmin == true;
    }

    // PIN 로그인 계정을 이메일로 명시 판정한다(admin@ / branch-NN@ 패턴).
    // "users 문서 없음"으로 판정하면 온보딩 완료 전·미승인·삭제된 개인계정(users 문서가 아직/이미 없음)이
    // PIN 계정으로 오인되어 업무 데이터에 접근하는 우회 구멍이 생긴다(Codex 지적 2026-07-27, no-ship).
    function isPinAccount() {
      return signedIn() && (
        request.auth.token.email == 'admin@ugd-erp.example'
        || request.auth.token.email.matches('^branch-[0-9]+@ugd-erp[.]example$')
      );
    }

    // 승인된 개인계정 — 관리자가 reviewedByAdmin=true로 승인해야 업무 데이터에 접근할 수 있다(2026-07-27).
    function isApprovedPersonal() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reviewedByAdmin == true;
    }

    // 업무 데이터 접근 자격: 기존 PIN 계정이거나, 승인된 개인계정(관리자 포함).
    // 미승인 개인계정은 로그인은 되지만 여기서 막혀 어떤 업무 데이터도 읽거나 쓸 수 없다.
    function canAccessWork() {
      return isPinAccount() || isApprovedPersonal() || isPersonalAdmin();
    }

    // 개인 계정 프로필. PIN 로그인 계정은 이 컬렉션을 사용하지 않는다.
    match /users/{uid} {
      // 본인 문서 읽기 + 개인 관리자 전체 읽기
      allow read: if signedIn() && (request.auth.uid == uid || isPersonalAdmin());
      // 본인 생성은 "신규 기본값 그대로"일 때만 — 셀프 권한 상향 차단.
      // 가입 시 이름·연락처·근무지점을 필수로 받는다(2026-07-27). hasOnly 목록은 userProfile.ts와 함께 유지.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name","email","phone","workBranch","role","allowedTabs","allowedBranches","status","createdAt","reviewedByAdmin"])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.workBranch is string
        && request.resource.data.createdAt is string
        && request.resource.data.role == "branch"
        && request.resource.data.allowedTabs == "all"   // 신규 = 전 탭 허용(사용자 지시 2026-07-25). 제한은 관리자가 계정 관리 탭에서.
        && request.resource.data.allowedBranches == "all"
        && request.resource.data.status == "active"
        // 원칙: 신규는 미승인. 예외: 2026-07-29 00:00 KST(=1785250800000ms) 전 가입은 자동승인 허용(지점 전환 편의).
        // 이 시각이 지나면 reviewedByAdmin==true 가입이 규칙에서 거부되어 자동으로 승인제로 복귀한다(코드가 안 닫혀도 규칙이 닫는다).
        // role=="branch"는 위에서 이미 강제 — 자동승인이어도 관리자 계정은 만들어지지 않는다. userProfile.ts AUTO_APPROVE_UNTIL_MS와 일치.
        && (
          request.resource.data.reviewedByAdmin == false
          || (request.time.toMillis() < 1785250800000 && request.resource.data.reviewedByAdmin == true)
        );
      // 수정·삭제는 개인 관리자만, 본인 문서는 관리자라도 불가(셀프 정지해제·권한조작 차단).
      // 주의: PIN 관리자(admin@ugd-erp.example)는 여기서 의도적으로 배제 — isAdmin() 쓰지 말 것.
      allow update, delete: if isPersonalAdmin() && request.auth.uid != uid;
    }

    // 로그인 전 지점 선택 화면에 필요한 공개 정보만 둡니다. PIN·해시값은 포함하지 않습니다.
    match /public_branches/{branchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isPersonalAdmin();
    }

    // 지점 설정 및 PIN 관련 데이터는 인증 후에만 읽고, 관리 계정만 변경합니다.
    match /settings/{branchId} {
      allow read: if canAccessWork();
      allow create, update, delete: if isAdmin() || isPersonalAdmin();
    }

    // 일일마감 원본 데이터입니다. 공통 지점 PIN 정책이므로 승인된 사용자가 조회·저장합니다.
    match /daily_settles/{recordId} {
      allow read: if canAccessWork();
      allow create, update: if canAccessWork()
        && request.resource.data.recordId is string
        && request.resource.data.master is map
        && request.resource.data.expenses is list
        && request.resource.data.staff is list;
      allow delete: if canAccessWork();
    }

    match /staff_rosters/{branchId} {
      allow read, write: if canAccessWork();
    }

    match /branch_own_rosters/{branchId} {
      allow read, write: if canAccessWork();
    }

    // 정직원 급여대장 문서인지 판별 — 키 형식: monthly_fulltime_salary:{지점}:{월}
    // (shared_data 문서 ID는 encodeURIComponent 되어 저장되므로 ':'는 '%3A'로 인코딩된다. 두 형태를 모두 본다.)
    function isSalaryKey(dataKey) {
      return dataKey.matches('^monthly_fulltime_salary(:|%3A).*');
    }

    // 급여대장 키에서 지점명 조각을 꺼낸다.
    // 주의: shared_data 문서 ID는 encodeURIComponent 된 값이라 한글 지점명이 '%EB%82%A8...' 형태다.
    // 규칙에는 URL 디코딩이 없으므로 원문과 비교할 수 없다 —
    // 그래서 users 문서의 salaryBranchesEncoded(인코딩본)와 비교한다(userProfile.withEncodedSalaryBranches가 채운다).
    function salaryBranchOf(dataKey) {
      return dataKey.split('%3A').size() > 1
        ? dataKey.split('%3A')[1]
        : dataKey.split(':')[1];
    }

    // 이 사용자가 해당 지점의 급여대장을 열람/수정할 수 있는가.
    // salaryBranchesEncoded: 'all'=총관리자(전 지점), list=해당 지점만, 없음/[]=불가(fail-closed).
    // PIN 로그인 계정(users 문서 없음)은 전환기 동안 기존 동작 유지 — 탭 비밀번호가 1차 방어.
    // src/utils/salaryAccess.ts(canReadSalaryBranch)와 같은 판정을 유지할 것.
    function canReadSalary(dataKey) {
      // 개인 관리자(총관리자)는 항상 전 지점 열람 — salaryBranches 미지정이어도 통과시킨다.
      // 이게 없으면 첫 관리자가 자기 권한을 스스로 줄 수 없어(users 자기문서 수정 불가) 콘솔 없이는 못 푸는 데드락이 된다(2026-07-27).
      return isPinAccount() || isPersonalAdmin() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('salaryBranchesEncoded', []) == 'all'
          // 리스트 포함 검사는 hasAny를 쓴다 — 'in'은 리스트 멤버십 판정에 맞지 않아
          // 권한이 있는 지점관리자까지 거부될 수 있다(Codex 지적 2026-07-27).
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('salaryBranchesEncoded', []).hasAny([salaryBranchOf(dataKey)])
        )
      );
    }

    match /shared_data/{dataKey} {
      // 급여대장(급여·주민번호·계좌)은 지점별 열람 권한까지 통과해야 한다. 그 외 공유 데이터는 현행 유지.
      allow read, write: if canAccessWork() && (!isSalaryKey(dataKey) || canReadSalary(dataKey));
    }

    // 백업 문서 ID는 '{인코딩된 dataKey}--{timestamp}' 형식이라 급여대장 백업도 같은 함수로 판별된다
    // (isSalaryKey/salaryBranchOf가 '%3A' 기준으로 지점 조각을 그대로 꺼낸다).
    // 여기를 막지 않으면 급여대장 이전 값이 백업으로 복사되어 권한 없는 계정이 급여·주민번호·계좌를 그대로 읽는다(Codex 지적 2026-07-27).
    match /shared_data_backups/{backupId} {
      allow read, write: if canAccessWork() && (!isSalaryKey(backupId) || canReadSalary(backupId));
    }

    match /edit_logs/{logId} {
      allow read, create: if canAccessWork();
      allow update, delete: if isAdmin() || isPersonalAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
